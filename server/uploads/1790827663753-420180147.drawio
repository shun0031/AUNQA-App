<mxfile host="app.diagrams.net" agent="Claude">
  <diagram id="nosql-schema-aunqa" name="Schema Diagram (NoSQL - MongoDB) - AUN-QA">
    <mxGraphModel dx="3535" dy="1943" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A237E;align=center;" value="&lt;font style=&quot;font-size: 34px;&quot;&gt;Schema Diagram (NoSQL / MongoDB): ระบบจัดเก็บข้อมูลและหลักฐานอ้างอิง AUN-QA&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="1300" x="1100" y="80" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontColor=#546E7A;align=center;fontStyle=2;" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;แนวทาง Hybrid — ข้อมูลหลัก (roles / permissions / departments / courses / criteria / users) ใช้ Reference | หลักฐานแนบ (evidences) และประวัติการตรวจ (review_history) ใช้ Embedded Array&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="1300" x="1090" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c_roles" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;roles&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;role_name&lt;br&gt;permission_ids: [ObjectId]&lt;br&gt;&amp;nbsp;&amp;nbsp;(ref → permissions, array)&lt;/font&gt;" vertex="1">
          <mxGeometry height="270" width="290" x="440" y="570" as="geometry" />
        </mxCell>
        <mxCell id="c_permissions" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;permissions&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;permission_name&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="230" x="820" y="350" as="geometry" />
        </mxCell>
        <mxCell id="c_departments" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;departments&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;department_name&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="230" x="1200" y="268" as="geometry" />
        </mxCell>
        <mxCell id="c_criteria" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;criteria (เกณฑ์รายปีการศึกษา)&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;course_id (ref → courses)&lt;br&gt;academic_year&lt;br&gt;criteria_no&lt;br&gt;criteria_name&lt;br&gt;description&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="420" x="2080" y="200" as="geometry" />
        </mxCell>
        <mxCell id="c_courses" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;courses&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;course_name&lt;br&gt;department_id (ref → departments)&lt;br&gt;status&lt;/font&gt;" vertex="1">
          <mxGeometry height="250" width="380" x="1640" y="200" as="geometry" />
        </mxCell>
        <mxCell id="c_users" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;users&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;username (unique)&lt;br&gt;password_hash&lt;br&gt;full_name&lt;br&gt;address&lt;br&gt;phone&lt;br&gt;email (unique)&lt;br&gt;line_id&lt;br&gt;role_id (ref → roles)&lt;br&gt;department_id (ref → departments)&lt;br&gt;status (active / inactive)&lt;br&gt;last_login&lt;br&gt;created_date&lt;br&gt;updated_date&lt;/font&gt;" vertex="1">
          <mxGeometry height="620" width="340" x="1270" y="645" as="geometry" />
        </mxCell>
        <mxCell id="c_records" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;aunqa_records&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;criteria_id (ref → criteria)&lt;br&gt;course_id (ref → courses)&lt;br&gt;academic_year&lt;br&gt;description&lt;br&gt;status (enum — ดูหมายเหตุ)&lt;br&gt;created_by: { user_id (ref), full_name }&lt;br&gt;review_comment&lt;br&gt;reviewed_by: { user_id (ref), full_name }&lt;br&gt;reviewed_date&lt;br&gt;review_history: [ ... ] (embedded)&lt;br&gt;confirmed_by: { user_id (ref), full_name }&lt;br&gt;confirmed_date&lt;br&gt;created_date&lt;br&gt;updated_date&lt;br&gt;evidences: [ ... ] (embedded array →)&lt;/font&gt;" vertex="1">
          <mxGeometry height="700" width="470" x="2080" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c_evidences" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#fff2e0;strokeColor=#d79b00;strokeWidth=2;dashed=1;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;evidences[]  (embedded — ไม่ใช่ collection แยก)&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;evidence_id&lt;br&gt;evidence_type (file/image/text/link)&lt;br&gt;file_id (ref → files) — เมื่อเป็นไฟล์/รูป&lt;br&gt;text — เมื่อเป็นข้อความ&lt;br&gt;url — เมื่อเป็นลิงก์&lt;br&gt;uploaded_by (ref → users)&lt;br&gt;uploaded_date&lt;/font&gt;" vertex="1">
          <mxGeometry height="440" width="360" x="2750" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_files" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;files (Admin จัดการไฟล์ทั้งหมด)&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;original_name&lt;br&gt;file_name&lt;br&gt;file_path&lt;br&gt;file_type&lt;br&gt;mime_type&lt;br&gt;file_size&lt;br&gt;uploaded_by (ref → users)&lt;br&gt;upload_date&lt;/font&gt;" vertex="1">
          <mxGeometry height="430" width="330" x="2080" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="c_logs" parent="1" style="shape=document;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;boundedLbl=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;system_logs&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;_id (PK)&lt;br&gt;user_id (ref → users)&lt;br&gt;action&lt;br&gt;target_collection&lt;br&gt;target_id&lt;br&gt;detail&lt;br&gt;timestamp&lt;br&gt;ip_address&lt;/font&gt;" vertex="1">
          <mxGeometry height="380" width="300" x="860" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="r1" edge="1" parent="1" source="c_roles" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;" target="c_permissions" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;ref: permission_ids[]&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" edge="1" parent="1" source="c_users" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;" target="c_roles" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;ref: role_id&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" edge="1" parent="1" source="c_users" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;" target="c_departments" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;ref: department_id&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" edge="1" parent="1" source="c_users" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.3;entryX=0;entryY=0.25;" target="c_records" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;created_by (ref + snapshot)&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r5" edge="1" parent="1" source="c_users" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.42;" target="c_records" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;confirmed_by (ref + snapshot)&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r6" edge="1" parent="1" source="c_users" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.9;entryX=0;entryY=0.5;exitDx=0;exitDy=0;" target="c_files" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;ref: uploaded_by&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r7" edge="1" parent="1" source="c_users" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;exitX=0;exitY=0.85;entryX=1;entryY=0.5;" target="c_logs" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;ref: user_id&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r8" edge="1" parent="1" source="c_records" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=1;endArrow=none;dashed=1;strokeWidth=2;fontSize=19;strokeColor=#9673A6;fontColor=#9673A6;" target="c_evidences" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;embedded array (ฝังอยู่ใน document เดียวกัน)&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r13" parent="1" edge="1" source="c_evidences" target="c_files" value="ref: file_id" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r12" parent="1" edge="1" source="c_courses" target="c_departments" value="department_id (ref)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r11" parent="1" edge="1" source="c_criteria" target="c_courses" value="course_id (ref)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r10" parent="1" edge="1" source="c_records" target="c_criteria" value="criteria_id (ref)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r9" parent="1" edge="1" source="c_users" target="c_records" value="reviewed_by (ref + snapshot)" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=open;endFill=1;fontSize=19;strokeColor=#333333;fontColor=#333333;exitX=1;exitY=0.7;entryX=0;entryY=0.68;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legendBox" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1;shadow=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;" value="&lt;font style=&quot;font-size: 27px;&quot;&gt;&lt;b style=&quot;&quot;&gt;คำอธิบายสัญลักษณ์&lt;/b&gt;&lt;br&gt;━━→ เส้นทึบ = &lt;b style=&quot;&quot;&gt;Reference&lt;/b&gt; (เก็บ ObjectId แล้วอ้างอิงไป collection อื่น ต้อง populate() เอาข้อมูลจริงตอน query)&lt;br&gt;╌╌◆ เส้นประ = &lt;b style=&quot;&quot;&gt;Embedded&lt;/b&gt; (ฝังข้อมูลไว้เป็น sub-document/array ภายใน document เดียวกัน ไม่ใช่ collection แยก)&lt;/font&gt;" vertex="1">
          <mxGeometry height="162.5" width="1570" x="150" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="noteBox" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1;shadow=1;" value="" vertex="1">
          <mxGeometry height="470" width="1600" x="1780" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="noteTitle" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#37474F;align=left;" value="&lt;font style=&quot;font-size: 26px;&quot;&gt;หมายเหตุ: การออกแบบเทียบกับ ER (SQL) เดิม&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="700" x="1830" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="noteText" parent="1" style="text;html=1;fontSize=11;fontColor=#455A64;align=left;spacing=4;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;• TB_ROLE_PERMISSION ถูกยุบรวมเป็น array &quot;permission_ids&quot; ภายใน roles — ไม่ต้องมี collection junction แบบ SQL&lt;br&gt;• TB_EVIDENCE ไม่ใช่ collection แยก แต่ฝัง (embed) เป็น array ใน aunqa_records เพราะถูกดึงมาใช้พร้อมกันเสมอ ส่วนไฟล์จริงเก็บใน files แล้วอ้างด้วย file_id&lt;br&gt;• courses / criteria แยก collection เพราะ Admin เป็นผู้จัดการ และเกณฑ์เปลี่ยนได้ทุกปีการศึกษา (criteria มี academic_year) — records อ้างอิงด้วย criteria_id&lt;br&gt;• course_id และ academic_year ใน aunqa_records เป็นค่าซ้ำจาก criteria (denormalize) เพื่อทำ index ค้นหา/ติดตามสถานะได้เร็ว ต้อง sync เองถ้าแก้ criteria&lt;br&gt;• status ของ record: draft (อาจารย์กำลังบันทึก) → submitted (ส่งตรวจ) → returned (AUN-QA ส่งกลับให้แก้หลักฐานใหม่) → confirmed (AUN-QA ยืนยันแล้ว)&lt;br&gt;• review_history ฝังใน record เก็บทุกรอบที่ AUN-QA ตรวจ/ส่งกลับ (reviewer, action, comment, date) เพื่อย้อนดูประวัติได้&lt;br&gt;• created_by / reviewed_by / confirmed_by เก็บทั้ง ref (user_id) และ snapshot (full_name) กันชื่อหายถ้า user ถูกลบ แต่ต้อง sync เองถ้าชื่อเปลี่ยน&lt;br&gt;• ต้องคุม referential integrity เอง (Mongoose middleware / application logic) เพราะ MongoDB ไม่บังคับ FK แบบ SQL และ password_hash ต้องเก็บค่าที่เข้ารหัสเท่านั้น&lt;/font&gt;" vertex="1">
          <mxGeometry height="390" width="1560" x="1800" y="2030" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>